# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Telegram storage
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INDEX_FILE_ID=

# PayHero (M-Pesa STK push) — https://app.payhero.co.ke
# Basic auth token from your PayHero dashboard: "Basic " + base64("username:password")
PAYHERO_BASIC_AUTH=
# ...or provide the pair below instead and the app builds the header itself
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# Your PayHero payment channel id
PAYHERO_CHANNEL_ID=
# Long random string; appended to the callback URL as ?secret=… and checked on every webhook
PAYHERO_WEBHOOK_SECRET=
# Optional: override the public callback URL (defaults to <your-domain>/api/payhero/callback)
# PAYHERO_CALLBACK_URL=https://your-domain.com/api/payhero/callback
