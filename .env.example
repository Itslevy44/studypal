# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Telegram storage
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INDEX_FILE_ID=

# M-Pesa (Daraja)
MPESA_ENVIRONMENT=sandbox        # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
# Recommended: a long random string. When set, it is appended to the callback URL
# (?secret=...) and the callback rejects requests that don't carry it.
MPESA_CALLBACK_SECRET=
